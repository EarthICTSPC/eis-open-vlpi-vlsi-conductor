{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earthictspc.com/schema/eis-optical-netlist-v0.1.schema.json",
  "title": "EIS Optical Netlist v0.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "instances",
    "connections",
    "inputs",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "ports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "laser",
              "mmi1x2",
              "mmi2x2",
              "fanoutTree",
              "mziCell",
              "balancedPhotodetector"
            ]
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/portRef"
          },
          "target": {
            "$ref": "#/$defs/portRef"
          }
        },
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/portRef"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/portRef"
      }
    }
  },
  "$defs": {
    "portRef": {
      "type": "object",
      "required": [
        "instanceId",
        "portName"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "portName": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
