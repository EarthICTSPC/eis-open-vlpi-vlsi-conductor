{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EarthICTSPC/eis-open-vlpi-pdk/blob/eis-crc-first-pairwise-comparator-001/experiments/EIS-CRC-FIRST-PAIRWISE-001/workload_trace.schema.json",
  "title": "EIS PRISM Workload Trace",
  "description": "Trace format for reproducible software-emulated workload evidence. It does not describe measured physical behavior.",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_class",
    "source",
    "run",
    "workload",
    "candidates",
    "selection",
    "system_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evidence_class": {
      "enum": [
        "SOFTWARE_EMULATED",
        "REPOSITORY_REPORTED_AGGREGATE",
        "MEASURED_HARDWARE",
        "SIMULATED_PHYSICS"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "repository_url",
        "commit_sha",
        "entrypoint",
        "artifact_sha256"
      ],
      "properties": {
        "repository_url": {
          "type": "string",
          "format": "uri"
        },
        "commit_sha": {
          "type": "string",
          "minLength": 7
        },
        "entrypoint": {
          "type": "string"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "seed",
        "timestamp_utc"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "workload": {
      "type": "object",
      "required": [
        "context_tokens",
        "candidate_count_N",
        "k",
        "block_size",
        "signature_dimension"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "layer": {
          "type": [
            "integer",
            "null"
          ]
        },
        "head": {
          "type": [
            "integer",
            "null"
          ]
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_count_N": {
          "type": "integer",
          "minimum": 2
        },
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "block_size": {
          "type": "integer",
          "minimum": 1
        },
        "signature_dimension": {
          "type": "integer",
          "minimum": 1
        },
        "batch_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "concurrency": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "reference_score",
          "final_score",
          "reference_rank",
          "selected"
        ],
        "properties": {
          "candidate_id": {
            "type": [
              "string",
              "integer"
            ]
          },
          "reference_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "score_pre_impairment": {
            "type": [
              "number",
              "null"
            ]
          },
          "score_post_impairment": {
            "type": [
              "number",
              "null"
            ]
          },
          "final_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "reference_rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "selected": {
            "type": "boolean"
          },
          "invalid_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "reference_topk_ids",
        "emulated_topk_ids"
      ],
      "properties": {
        "reference_topk_ids": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "emulated_topk_ids": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "ground_truth_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "downstream_metric_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "downstream_metric_value": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "system_boundary": {
      "type": "object",
      "required": [
        "latency_boundary",
        "energy_boundary",
        "thermal_stabilization_included"
      ],
      "properties": {
        "latency_boundary": {
          "type": "string"
        },
        "energy_boundary": {
          "type": "string"
        },
        "request_rate_per_second": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "source_energy_included": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "thermal_stabilization_included": {
          "type": "boolean"
        },
        "shared_static_energy_amortization": {
          "type": [
            "string",
            "null"
          ]
        },
        "unknown_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
